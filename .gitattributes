# Keep the distributed package minimal: nothing below is needed at runtime.
# /vendor is listed because `composer archive` builds from the working tree and
# does not honour .gitignore; without this the dist would carry every dev
# dependency.
/vendor             export-ignore
/composer.lock      export-ignore
/.phpunit.cache     export-ignore
/.phpunit.result.cache export-ignore
/.github            export-ignore
/tests              export-ignore
/examples           export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.editorconfig      export-ignore
/phpunit.xml.dist   export-ignore
/phpstan.neon.dist  export-ignore
/phpstan-strict.neon.dist export-ignore
/CONTRIBUTING.md    export-ignore
/RELEASING.md       export-ignore
/UPGRADE.md         export-ignore
/.git               export-ignore

# CHANGELOG.md and SECURITY.md are deliberately NOT export-ignored: they carry
# the 1.x credential and TLS disclosures, and an operator auditing an installed
# copy must be able to find that record in vendor/ without visiting GitHub.
